# Copy to .env and fill in. Never commit .env.
# Spring Boot does not read .env by itself: export these in your shell or add them
# to your IDE run configuration. (Docker Compose will load this file in Phase 8.)

SERVER_PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_STORAGE_LOCAL_ROOT=./storage

# --- Phase 1: Supabase ---
# Connection string from Supabase > Project Settings > Database (session pooler)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<database-password>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Phase 4: OpenAI ---
OPENAI_API_KEY=<openai-api-key>

# --- Phase 6: Google (Gmail drafts) ---
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:8080/api/google/callback
