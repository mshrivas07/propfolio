# Copy to .env. Vite exposes only variables prefixed with VITE_ to the browser,
# so never put secrets (OpenAI key, DB password, Google secret) in this file.

VITE_API_BASE_URL=http://localhost:8080

# --- Phase 1: Supabase (public values, safe for the browser) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
